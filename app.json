{
  "expo": {
    "name": "LEVEL UP",
    "slug": "level-up",
    "version": "1.0.0",
    "scheme": "levelup",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B0D",
